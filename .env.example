# Copy to .env and fill in. .env is git-ignored.

# GCP project that holds the analytics datasets.
GCP_PROJECT=my-gcp-project

# sha256(api_key) -> owner. Generate with: python scripts/hash_key.py
API_KEYS={"<sha256-digest>": {"user": "ana", "role": "analyst"}}

# Role -> datasets that role may query.
ROLE_DATASETS={"analyst": ["marketing"], "admin": ["marketing", "customers"]}

# "dataset.table.column" entries that must never be queried.
PII_COLUMNS=["customers.customers.email", "customers.customers.phone"]

# Max bytes a single query may scan (1 GiB).
MAX_BYTES_BILLED=1073741824
# Rows returned to the agent per query.
MAX_RESULT_ROWS=500

# Seconds to wait for a query to finish.
QUERY_TIMEOUT_SECONDS=60

# Datasets for the standalone MCP server only (python -m app.mcp_server).
MCP_ALLOWED_DATASETS=["marketing"]
